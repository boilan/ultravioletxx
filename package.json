{
	"name": "@titaniumnetwork-dev/ultraviolet",
	"version": "3.2.10",
	"description": "Highly sophisticated proxy used for evading internet censorship or accessing websites in a controlled sandbox using the power of service-workers and more!",
	"main": "lib/index.cjs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/titaniumnetwork-dev/Ultraviolet.git"
	},
	"files": [
		"dist",
		"lib",
		"uv.d.ts",
		"client.d.ts"
	],
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "node build.js",
		"start": "node build.js && node server/index.js",
		"test": "node build.js && node scripts/smoke.js",
		"dev": "node build.js --dev",
		"prepack": "npm run build",
		"format": "prettier --config .prettierrc.js --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.0",
		"@eslint/js": "^9.21.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.21.0",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"ws": "^8.22.0"
	},
	"dependencies": {
		"@mercuryworkshop/bare-as-module3": "^2.2.5",
		"@mercuryworkshop/bare-mux": "^2.1.7",
		"@tomphttp/bare-server-node": "^2.0.6",
		"astring": "^1.9.0",
		"events": "^3.3.0",
		"express": "^5.3.0",
		"idb": "^8.0.2",
		"meriyah": "^6.0.5",
		"parse5": "^7.2.1",
		"set-cookie-parser": "^2.7.1"
	}
}
